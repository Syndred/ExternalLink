{
  "manifest_version": 3,
  "name": "ExternalLink - 外链批量提交",
  "version": "2.8.0",
  "description": "外链质量排序、AI 评论、本地媒体预检、Google Sheet 变更提醒与链接存活监控工作台",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "notifications", "sidePanel", "alarms"],
  "host_permissions": ["https://*/*", "http://*/*", "http://127.0.0.1:8790/*"],
  "action": {
    "default_title": "ExternalLink - 打开侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/profiles.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
