# DeepSeek V4 Pro API 配置
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI 兼容模式（备选）
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Playwright 配置
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_BROWSER_CHANNEL=chrome
LOCAL_AGENT_PORT=8790

# Google Sheet sync (optional; keep both JSON paths outside this repository)
# Create a Desktop OAuth client in Google Cloud and point this path at the
# downloaded client JSON. Never commit the client JSON or refresh token.
GOOGLE_SHEET_ID=
GOOGLE_OAUTH_CLIENT_FILE=/Users/your-name/Library/Application Support/ExternalLink/google-client.json
# Optional fallback when the OS keyring is unavailable. The keyring is tried first.
GOOGLE_OAUTH_TOKEN_FILE=/Users/your-name/Library/Application Support/ExternalLink/google-token.json
GOOGLE_TOKEN_KEYRING_SERVICE=ExternalLink Google OAuth
GOOGLE_TOKEN_KEYRING_ACCOUNT=default
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8790/google/auth/callback
GOOGLE_SHEET_LINKS_TAB=Link Submit
GOOGLE_SHEET_RECORDS_TAB=Submission Records
GOOGLE_SHEET_META_TAB=SyncMeta
