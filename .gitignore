# Local credentials and OAuth material
.env
*client_secret*.json
*oauth*token*.json
google-token.json

# Browser session state may contain cookies and local storage
profiles/*/state.json

# Local runtime artifacts
__pycache__/
*.pyc
.DS_Store
*.db-shm
*.db-wal
cloud/worker/.wrangler/
.wrangler/
cloud/worker/node_modules/
executor/node_modules/
executor/test-output/

# Per-device pairing and durable local state must never enter a checkout.
enrollment.json
pairing.txt
outbox.sqlite*
.externallink-executor/
