{
  "manifest_version": 3,
  "name": "ExternalLink - 外链批量提交",
  "version": "3.3.12",
  "description": "云端保存外链库、完整资料字段、提交审核上线时间线与私有媒体",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "notifications", "sidePanel", "alarms", "contextMenus", "debugger"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "ExternalLink - 打开侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/profiles.js", "lib/playbooks.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
