{
  "manifest_version": 3,
  "name": "ExternalLink - 外链批量提交",
  "version": "2.6.0",
  "description": "按外链站分组的多网站提交工作台：Google Sheet 同步、成功账本、人工停放和断点恢复",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "notifications", "sidePanel"],
  "host_permissions": ["https://*/*", "http://*/*", "http://127.0.0.1:8790/*"],
  "action": {
    "default_title": "ExternalLink - 打开侧边栏"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/profiles.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
